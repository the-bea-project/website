}

def cousins() -> Element(msg) {
  html.section(
    [class("cousins"), attribute.aria_labelledby("cousins-title")],
    [
      html.div([class("wrap cousins-inner")], [
        html.img([
          attribute.src("assets/beatrix.svg"),
          attribute.alt("Beatrix"),
          attribute.width(160),
          attribute.height(160),
        ]),
        html.div([class("prose")], [
          html.h2([id("cousins-title")], [html.text("Meet Beatrix")]),
          markup.p(
            "Beatrix is Bea's mascot: a small, cheerful black hole. Gleam's Lucy is a star, which makes the two of them cousins in the same sky. Whatever you write falls into Beatrix, and Gleam comes out the other side.",
          ),
        ]),
      ]),
    ],
  )
}
