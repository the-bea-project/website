//// Compiles one Bea module to Gleam.

import bea/associated
import bea/ast
import bea/codegen
import bea/deriving
import bea/diagnostic.{type Diagnostic}
import bea/doc
import bea/lower
import bea/parser
import gleam/list

pub type Compiled {
  Compiled(
    gleam: String,
    mappings: List(doc.Mapping),
    warnings: List(Diagnostic),
    module: ast.Module,
  )
}

pub def parse(source: String) -> Result(ast.Module, List(Diagnostic)) {
  parsed = parser.parse_module(source)
  case parsed.errors {
    [] -> Ok(parsed.module)
    errors -> Error(errors)
  }
}

pub def compile(
  source: String,
  ctx: codegen.Context,
) -> Result(Compiled, List(Diagnostic)) {
  case parse(source) {
    Error(errors) -> Error(errors)
    Ok(module) -> compile_module(module, ctx)
  }
}

pub def compile_module(
  module: ast.Module,
  ctx: codegen.Context,
) -> Result(Compiled, List(Diagnostic)) {
  (derived, derive_errors) = deriving.module(module, ctx)
  (resolved, associated_errors) = associated.module(derived, module)
  (lowered, diagnostics) = lower.module(resolved)
  diagnostics = list.flatten([derive_errors, associated_errors, diagnostics])
  (errors, warnings) = list.partition(diagnostics, diagnostic.is_error)
  case errors {
    [_ | _] -> Error(errors)
    [] -> {
      out = codegen.generate(lowered, ctx)
      Ok(Compiled(out.code, out.mappings, warnings, module))
    }
  }
}
