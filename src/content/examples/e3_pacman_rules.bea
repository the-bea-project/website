import gleam/io

def eat_ghost(power_pellet_active: Bool, touching_ghost: Bool) -> Bool {
  touching_ghost and power_pellet_active
}

def score(touching_power_pellet: Bool, touching_ghost: Bool) -> Bool {
  touching_ghost or touching_power_pellet
}

def lose(power_pellet_active: Bool, touching_ghost) -> Bool {
  touching_ghost and not power_pellet_active
}

pub def main() {
  echo eat_ghost(True, False)
  echo score(False, True)
  echo lose(True, True)
  io.println("Done!")
}