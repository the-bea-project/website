import gleam/string

def message(log_line: String) -> String {
  [_, message] = string.split(log_line, ": ")
  message |> string.trim()
}

def log_level(log_line: String) -> String {
  [level | _] = log_line |> string.split(": ")
  
  level
  |> string.replace("[", "")
  |> string.replace("]", "")
  |> string.lowercase()
}

def reformat(log_line: String) -> String {
  m = message(log_line)
  l = log_level(log_line)

  "#{m} (#{l})"
}

pub def main() {
  echo message("[WARNING]:  Disk almost full\r\n")
  echo log_level("[ERROR]: Invalid operation")
  echo reformat("[INFO]: Operation completed")
}